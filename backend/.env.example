# Example values only. Copy to .env and never commit the real file.
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Empty DB_HOST = SQLite (tests, laptop). Set it to use PostgreSQL.
# Use a new database name; the existing "d2a" database holds the FastAPI tables.
DB_HOST=
DB_PORT=5432
DB_NAME=d2a_django
DB_USER=d2a
DB_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
FASTAPI_BASE_URL=http://fastapi:8001
