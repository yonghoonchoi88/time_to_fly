# Example values only. Copy to .env and never commit the real file.
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Empty DB_HOST = SQLite (tests, laptop). Set it to use PostgreSQL.
# Use a new database name; the existing "d2a" database holds the FastAPI tables.
DB_HOST=
DB_PORT=5432
DB_NAME=d2a_django
DB_USER=d2a
DB_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
FASTAPI_BASE_URL=http://fastapi:8001
AI_SERVER_TIMEOUT_S=30

# Directory of inspected frames (shared by web and the celery worker).
IMAGE_DIR=
# 1 = run Celery tasks inline without Redis (local experiments only).
CELERY_TASK_ALWAYS_EAGER=0
