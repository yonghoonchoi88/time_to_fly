POSTGRES_USER=d2a
POSTGRES_PASSWORD=change-me
POSTGRES_DB=d2a

# Django uses its own database in the same server; db-init creates it on `docker compose up`.
DJANGO_DB_NAME=d2a_django
# Leave unset for local dev (a long insecure dev default is used). Set a long random value elsewhere.
# DJANGO_SECRET_KEY=

# ai-server engine: mock (default) | yolo.
# yolo also needs WITH_YOLO=1 (image build) and MODEL_WEIGHTS=/models/<file>.pt from ./data/models.
ENGINE=mock
# WITH_YOLO=1
# MODEL_WEIGHTS=/models/final_best.pt
# MODEL_NAME=kimchi-yolo
# MODEL_VERSION=
